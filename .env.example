# ==========================================
# Breeze Docker 部署配置
# 复制此文件为 .env 并修改配置
# ==========================================

# -------------------- 数据库 --------------------
# 使用内置 PostgreSQL（默认）：docker compose --profile infra up -d
# 使用外部 PostgreSQL：修改 DB_HOST 为你的数据库地址
DB_HOST=postgres
DB_PORT=5432
DB_NAME=breeze
DB_USER=breeze
DB_PASSWORD=breeze123

# -------------------- Redis --------------------
# 使用内置 Redis（默认）：docker compose --profile infra up -d
# 使用外部 Redis：修改 REDIS_HOST 为你的 Redis 地址
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=breeze123

# -------------------- MinIO（文件存储） --------------------
# 默认使用内置 MinIO，无需改动
# 如使用外部 S3 兼容存储，修改下方 S3_* 变量
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -------------------- 文件存储 --------------------
# minio: 使用内置/外部 S3 兼容存储（Docker 部署推荐）
# local: 本地文件系统（仅开发环境）
# oss: 阿里云 OSS
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=breeze
S3_CDN_DOMAIN=
S3_URL_EXPIRATION=120

# -------------------- 应用端口 --------------------
BACKEND_PORT=8080
FRONTEND_PORT=80

# -------------------- AI 服务（必填） --------------------
DEEPSEEK_API_KEY=sk-your-key-here
# Embedding 向量化（OpenAI 兼容 API）
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small

# -------------------- 安全 --------------------
JWT_SECRET=change-me-in-production-min-256-bits
